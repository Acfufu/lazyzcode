# macOS
.DS_Store

# 本机私有工具产物（安全扫描历史等）
.mimosa/

# Node（P0 起启用）
node_modules/

# 文档站构建产物（scripts/docs-preview 输出）
dist/

# LazyZCode 运行时状态（目标循环/证据截图，按报告口径不入库）
.lazyzcode/

# 本地产物目录（对比报告等工作文件，不入库）
artifacts/

.mem/
.memignore
.workbuddy

# codegraph 本地索引（工具自建库，不入库）
.codegraph/
.zcode/

# ZCode 工作区忽略清单（带「以上同步自 .gitignore」标记的生成件，同步即改写；本机工具面不入库）
.zcodeignore

# pnpm 误跑再生锁文件（本仓零依赖根包；2026-09-14 Q3 拍板升 ignore——删了三回复发）
pnpm-lock.yaml

# npm 误装再生锁文件（本仓零依赖根包；2026-09-25 意外 npm install ai 事故后升 ignore，根锚定不涉 scripts/docs-preview/ 独立依赖）
/package-lock.json
