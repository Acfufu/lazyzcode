{
  "schemaVersion": 1,
  "capabilities": {
    "check": [
      {
        "id": "test-suite",
        "argv": ["node", "--test", "test/**/*.test.js"],
        "timeoutMs": 600000,
        "env": ["TZ"],
        "inputPaths": ["core", "cli", "plugin", "scripts", "test", "docs", "package.json", "lzy.project.json", "CHANGELOG.md", "README.md", "README.zh-CN.md", "LICENSE", ".github"]
      },
      {
        "id": "help-smoke",
        "argv": ["node", "cli/lzy.js", "--help"],
        "timeoutMs": 30000,
        "inputPaths": ["cli", "core", "package.json", "lzy.project.json"]
      }
    ]
  }
}
