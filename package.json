{
  "name": "lazyzcode",
  "version": "0.1.1",
  "description": "AI coding-workflow discipline layer for ZCode: plan, execute, take evidence, never stop half-done. Plugin + lightweight CLI (lzy).",
  "keywords": [
    "zcode",
    "ai-coding",
    "coding-agent",
    "agent-workflow",
    "discipline",
    "goal-loop",
    "plan-gate",
    "evidence",
    "cli",
    "plugin",
    "developer-tools"
  ],
  "type": "module",
  "license": "MIT",
  "author": "LazyZCode contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acfufu/lazyzcode.git"
  },
  "bugs": {
    "url": "https://github.com/acfufu/lazyzcode/issues"
  },
  "homepage": "https://acfufu.github.io/lazyzcode/",
  "bin": {
    "lzy": "cli/lzy.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "cli/",
    "core/",
    "plugin/",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "!**/.mimosa",
    "!**/.mimosa/**"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "install:local": "node cli/lzy.js install",
    "uninstall:local": "node cli/lzy.js uninstall",
    "sync": "node cli/lzy.js sync",
    "status": "node cli/lzy.js status",
    "doctor": "node cli/lzy.js doctor",
    "loop": "node cli/lzy.js loop",
    "step": "node cli/lzy.js step"
  }
}
