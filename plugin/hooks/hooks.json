{
  "description": "LazyZCode goal-loop hooks: trigger-word bootstrap, session bootstrap, Stop continuation (budget-capped, sessionId-isolated) and comment-checker advisory (goal-gated, inject-only). All commands run via run-hook.sh so node resolves even when the engine spawns hooks with a PATH that has no node.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${ZCODE_PLUGIN_ROOT}/hooks/run-hook.sh\" comment-checker.js",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${ZCODE_PLUGIN_ROOT}/hooks/run-hook.sh\" trigger.js",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${ZCODE_PLUGIN_ROOT}/hooks/run-hook.sh\" session-start.js",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${ZCODE_PLUGIN_ROOT}/hooks/run-hook.sh\" stop.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
