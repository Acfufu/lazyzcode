{
  "description": "LazyZCode goal-loop hooks: session bootstrap and Stop continuation (budget-capped, sessionId-isolated)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/hooks/session-start.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/hooks/stop.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
