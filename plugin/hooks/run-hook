#!/bin/sh
# lzy 钩子启动器（POSIX 面）：引擎以自身 env 直接 spawn 钩子命令，其 PATH 不保证解析得到 node
#（2026-09-07 探针实锤：GUI 直启的引擎 env 无 nvm bin，裸 `node` ENOENT → 四钩子静默全灭，
# 且失败发生在引擎侧，钩子 JS 里的 fail-open 根本没机会执行）。
# 用法（hooks.json）："${ZCODE_PLUGIN_ROOT}/hooks/run-hook" <script.js> [args…]
#   POSIX（sh -c）按 shebang 走本文件；Windows（cmd.exe）经 PATHEXT 解析对偶孪生 run-hook.cmd
#   （两文件一行清单跨双平台，schema 无平台字段，见 docs/design-crossplatform.md §1）。
# 纪律：node 彻底解析不到时记一行 /tmp/lzy-hook-launcher.log 后 exit 0 放行（fail-open，绝不阻断会话）。
set -u
dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

launcher_log() {
  printf '%s lzy hook: %s\n' "$(date -u +%FT%TZ)" "$1" >> /tmp/lzy-hook-launcher.log 2>/dev/null || true
}

# sort -V 功能探针（不只看退出码）：能自然排序 v2/v10 才算可用。
# 不支持时回退语义 = 字典序 last-wins（历史行为：取最后可执行者），并记一行日志。
sort_by_version_ok() {
  [ "$(printf 'v2\nv10\n' | sort -V 2>/dev/null | tail -n 1)" = "v10" ]
}

resolve_node() {
  if command -v node >/dev/null 2>&1; then
    NODE="$(command -v node)"   # PATH 有声明权：显式 PATH 解析优先，不参与版本比较
    return 0
  fi
  NODE=""
  # nvm 候选按**版本序**取最大（V021-ADJ-57）：glob 是字典序，v9.x 残留会排在 v24.x 之后
  #（"v9" > "v2x" 逐字节），旧 last-wins 因此选中 Node 9 → 六钩子解析即失败，且 exec 已替换
  # shell，fail-open 通道不覆盖此路径。
  nvm_cands=""
  for cand in "${HOME:-}"/.nvm/versions/node/*/bin/node; do
    [ -x "$cand" ] && nvm_cands="${nvm_cands}${cand}
"
  done
  if [ -n "$nvm_cands" ]; then
    if sort_by_version_ok; then
      NODE="$(printf '%s' "$nvm_cands" | sort -V | tail -n 1)"
    else
      NODE="$(printf '%s' "$nvm_cands" | tail -n 1)"
      launcher_log "node: sort -V unavailable; nvm fallback keeps lexicographic last-wins (selected ${NODE})"
    fi
  fi
  # 无版本目录的系统级 fallback（路径不含版本段，不参与版本比较）：nvm 无候选时才用。
  if [ -z "$NODE" ]; then
    for cand in /opt/homebrew/bin/node /usr/local/bin/node; do
      [ -x "$cand" ] && NODE="$cand"
    done
  fi
  [ -n "$NODE" ]
}

if [ "${1-}" = "--print-node" ]; then
  # 供 lzy doctor 的 hook-node 检查探测启动器解析结果（所选版本经此行可观测）
  if resolve_node; then printf '%s\n' "$NODE"; exit 0; else exit 1; fi
fi

script="${1-}"
shift 2>/dev/null || true
if [ -z "$script" ]; then exit 0; fi
if ! resolve_node; then
  launcher_log "node unresolvable (PATH=${PATH-}); ${script} skipped (fail-open)"
  exit 0
fi
exec "$NODE" "$dir/$script" "$@"
